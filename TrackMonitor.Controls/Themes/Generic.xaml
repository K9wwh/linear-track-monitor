<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TrackMonitor.Controls"
    xmlns:conv="clr-namespace:TrackMonitor.Controls.Converters">

    <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    <!-- WPF 内置:bool → Visibility(true=Visible / false=Collapsed)。用于按 HasTarget 显隐三角和 ETA。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ============================ 水平模板 ============================ -->
    <ControlTemplate x:Key="HorizontalTemplate" TargetType="{x:Type local:LinearTrackMonitor}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6" Padding="12" MinWidth="320">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部:状态(配色) + 位置 + 百分比 -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="状态: "/>
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusToBrush}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="位置: "/>
                        <TextBlock FontWeight="Bold" Text="{Binding Position, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}"/>
                        <TextBlock Margin="6,0,0,0" Foreground="#9AA0A6" Text="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}({0:F0}%)}"/>
                    </StackPanel>
                </Grid>

                <!-- 轨道(水平) -->
                <Grid Grid.Row="1" Height="40" VerticalAlignment="Center" Margin="8,0">
                    <Border Height="6" CornerRadius="3" Background="#444"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Canvas x:Name="PART_Track" ClipToBounds="False">
                        <Polygon x:Name="PART_TargetMarker" Points="0,0 12,0 6,11" Fill="#F2C037" Canvas.Top="3"
                                 Visibility="{Binding HasTarget, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                        <Rectangle x:Name="PART_Thumb" Width="20" Height="20"
                                   Fill="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusToBrush}}"
                                   Canvas.Top="10"/>
                    </Canvas>
                </Grid>

                <!-- 滑轨两端的边界坐标:左 = Min,右 = Max -->
                <Grid Grid.Row="2" Margin="0,0" VerticalAlignment="Top">
                    <TextBlock HorizontalAlignment="Left"  Foreground="#9AA0A6" Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}"/>
                    <TextBlock HorizontalAlignment="Right" Foreground="#9AA0A6" Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}"/>
                </Grid>

                <!-- 底部:速度(带正负号) + ETA -->
                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="速度: "/>
                        <TextBlock FontWeight="Bold" Text="{Binding Speed, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding HasTarget, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ETA: "/>
                        <TextBlock FontWeight="Bold" Text="{Binding Eta, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}}"/>
                        <TextBlock Text=" s"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- ============================ 垂直模板 ============================ -->
    <!-- 轨道在左列(垂直),读数竖排在右列。两套模板共用同名部件 PART_*,代码按 Orientation 选轴定位。 -->
    <ControlTemplate x:Key="VerticalTemplate" TargetType="{x:Type local:LinearTrackMonitor}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6" Padding="12" MinHeight="320">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 轨道(垂直):上端标 Max、下端标 Min -->
                <Grid Grid.Column="0" Width="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" HorizontalAlignment="Center" Foreground="#9AA0A6" Margin="0,0,0,12"
                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}"/>
                    <!-- 上下留 14px:滑块到尽头时会探出半个身位(10px),给标注留出不被遮挡的空间 -->
                    <Grid Grid.Row="1">
                        <Border Width="6" CornerRadius="3" Background="#444"
                                HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                        <Canvas x:Name="PART_Track" ClipToBounds="False">
                            <Polygon x:Name="PART_TargetMarker" Points="0,0 11,6 0,12" Fill="#F2C037" Canvas.Left="6"
                                     Visibility="{Binding HasTarget, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                            <Rectangle x:Name="PART_Thumb" Width="20" Height="20"
                                       Fill="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusToBrush}}"
                                       Canvas.Left="10"/>
                        </Canvas>
                    </Grid>
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" Foreground="#9AA0A6" Margin="0,12,0,0"
                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}"/>
                </Grid>

                <!-- 读数(竖排) -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="状态: "/>
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusToBrush}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="位置: "/>
                        <TextBlock FontWeight="Bold" Text="{Binding Position, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}"/>
                        <TextBlock Margin="6,0,0,0" Foreground="#9AA0A6" Text="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}({0:F0}%)}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="速度: "/>
                        <TextBlock FontWeight="Bold" Text="{Binding Speed, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding HasTarget, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ETA: "/>
                        <TextBlock FontWeight="Bold" Text="{Binding Eta, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}}"/>
                        <TextBlock Text=" s"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- ============================ 样式 + 方向切换 ============================ -->
    <Style TargetType="{x:Type local:LinearTrackMonitor}">
        <Setter Property="Background"  Value="#1E1E1E"/>
        <Setter Property="BorderBrush" Value="#3C3C3C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <!-- 默认水平;Orientation=Vertical 时触发器换成垂直模板 -->
        <Setter Property="Template" Value="{StaticResource HorizontalTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource VerticalTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
